{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "news-digest",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",

  // 靜態頁面放在 public/；只有 /api/* 會進到 Worker，其餘直接由靜態資源回應
  "assets": {
    "directory": "./public",
    "run_worker_first": ["/api/*"]
  },

  // Workers AI（不需要 API key）
  "ai": { "binding": "AI" },

  // 這個檔案是範本。實際使用的 wrangler.jsonc 已加進 .gitignore（裡面有自己的 KV id），不會被推上去。
  // KV id 的取得：npx wrangler kv namespace create NEWS
  "kv_namespaces": [
    { "binding": "NEWS", "id": "<你的 KV namespace id>" }
  ],

  // 每個 IP 每分鐘最多 60 次 API（靜態頁面不算）
  "ratelimits": [
    { "name": "API_LIMIT", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } }
  ],

  "durable_objects": {
    "bindings": [
      { "name": "COUNTER", "class_name": "VisitCounter" },
      // 台股盤中推送：有人在看時每 5 秒抓一次並推送給所有人
      { "name": "STOCKS", "class_name": "StockHub" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["VisitCounter"] },
    { "tag": "v2", "new_sqlite_classes": ["StockHub"] }
  ],

  // 排程使用 UTC。"0 4,10,23 * * *" = 每天 04:00、10:00、23:00 UTC
  // = 台灣時間 12:00、18:00、隔天 07:00（一天三次：早、中、晚）
  // 台股："30,40,50 6 * * 1-5" = 週一到週五台灣時間 14:30、14:40 抓收盤價（第二次是補抓），14:50 產生收盤分析
  "triggers": { "crons": ["0 4,10,23 * * *", "20,50 4,10,23 * * *", "30,40,50 6 * * 1-5"] },

  "vars": {
    // "workers-ai" 或 "claude"
    "SUMMARIZER": "workers-ai",
    "AI_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
    "CLAUDE_MODEL": "claude-haiku-5-5",
    "MAX_EVENTS_TW": "8",
    "MAX_EVENTS_WORLD": "8"
  },

  "observability": { "enabled": true }
}
